snippet type
  /**@var ${0}*/

snippet doc_var
  /**@var ${0}*/

snippet fn
  fn($${1:v})=>$${1}

snippet date_fmt
  Y-m-d

snippet datetime_fmt
  Y-m-d H:i:s

snippet time_fmt
  H:i:s

snippet dateJapanese
  Y年m月d日

snippet datetime
  Y年m月d日 H時i分s秒

snippet timeJapanese
  H時i分s秒

snippet daysinmonth
    \$days = date('t', mktime(0, 0, 0, \$month, 1, \$year));
